---
import Base from "../layouts/Base.astro";
import { getCopy, homePath } from "../i18n";

const copy = getCopy("en");
const home = homePath(copy.meta.locale);
---

<Base copy={copy} title={`${copy.notFound.title} · Narido`}>
  <section class="mx-auto flex min-h-[70vh] w-full max-w-6xl flex-col justify-center px-5 pt-32 pb-20 sm:px-8">
    <h1 class="text-5xl font-medium">{copy.notFound.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{copy.notFound.text}</p>
    <div class="mt-8">
      <a class="btn btn-primary" href={home}>{copy.notFound.cta}</a>
    </div>
  </section>
</Base>
