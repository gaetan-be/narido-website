---
import type { Accent, SiteCopy } from "../i18n";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;

const chip: Record<Accent, string> = {
  coral: "bg-coral",
  sunflower: "bg-sunflower",
  teal: "bg-teal",
  ink: "bg-ink",
};
---

<section id="work" class="scroll-mt-28 py-20 sm:py-28" aria-labelledby="work-title">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <h2 id="work-title" class="text-4xl font-medium sm:text-5xl">{copy.work.title}</h2>
      <p class="mt-4 text-lg text-pretty text-ink-soft">{copy.work.intro}</p>
    </div>
    <ol class="mt-12">
      {
        copy.work.projects.map((project, index) => (
          <li class="border-t border-ink/15 py-9" data-reveal style={`--d:${index * 60}ms`}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h3 class="flex items-center gap-3 text-3xl font-medium sm:text-4xl">
                <span class:list={["h-3.5 w-3.5 shrink-0 rounded-full", chip[project.accent]]} aria-hidden="true" />
                {project.title}
              </h3>
              <a
                class="inline-flex items-center gap-1.5 font-medium underline decoration-coral decoration-2 underline-offset-4"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.link}
                <span class="sr-only">({copy.work.newTab})</span>
                <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M4 12 12 4M6.5 4H12v5.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
            {project.paragraphs.map((paragraph) => (
              <p class="mt-4 max-w-3xl text-pretty text-ink-soft">{paragraph}</p>
            ))}
            {project.note && <p class="mt-4 max-w-3xl text-sm font-medium text-ink">{project.note}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
