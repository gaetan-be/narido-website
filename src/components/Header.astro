---
import { homePath, locales, type SiteCopy } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const home = homePath(copy.meta.locale);
const links = [
  { href: `${home}#services`, label: copy.nav.services },
  { href: `${home}#work`, label: copy.nav.work },
  { href: `${home}#background`, label: copy.nav.background },
  { href: `${home}#contact`, label: copy.nav.contact },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="flex h-1.5" aria-hidden="true">
    <span class="flex-1 bg-coral"></span>
    <span class="flex-1 bg-sunflower"></span>
    <span class="flex-1 bg-teal"></span>
  </div>
  <div class="header-bar" data-header-bar>
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
      <a href={`${home}#top`} class="inline-flex items-center gap-2.5" aria-label={copy.nav.home}>
        <Logo />
        <span class="font-display text-xl font-semibold tracking-tight">Narido</span>
      </a>
      <nav class="hidden items-center gap-7 md:flex" aria-label={copy.nav.landmark}>
        {
          links.map((link) => (
            <a class="text-sm font-medium text-ink-soft hover:text-ink" href={link.href} data-nav>
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="flex items-center gap-3 sm:gap-4">
        <nav class="lang-switch" aria-label={copy.nav.languages}>
          {
            locales.map((item, index) => (
              <span class="contents">
                {index > 0 && <span aria-hidden="true">/</span>}
                <a
                  href={item.href}
                  hreflang={item.htmlLang}
                  lang={item.htmlLang}
                  data-lang-switch
                  aria-current={item.locale === copy.meta.locale ? "page" : undefined}
                >
                  {item.label}
                </a>
              </span>
            ))
          }
        </nav>
        <a class="btn btn-primary hidden md:inline-flex" href={`${home}#contact`}>{copy.nav.cta}</a>
        <button
        type="button"
        id="menu-button"
        class="menu-button inline-flex h-11 w-11 items-center justify-center rounded-full text-ink md:hidden"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="sr-only" data-menu-label data-open={copy.nav.menu} data-close={copy.nav.close}>
          {copy.nav.menu}
        </span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        </button>
      </div>
    </div>
    <nav id="site-menu" class="menu-panel border-t border-ink/10" aria-label={copy.nav.landmark} hidden>
      {
        links.map((link) => (
          <a class="rounded-xl px-2 py-3 text-lg font-medium" href={link.href} data-nav>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary mt-2 mb-2" href={`${home}#contact`}>{copy.nav.cta}</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#menu-button");
  const menu = document.querySelector<HTMLElement>("#site-menu");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");
  const bar = document.querySelector<HTMLElement>("[data-header-bar]");
  const openLabel = label?.dataset.open ?? "Menu";
  const closeLabel = label?.dataset.close ?? "Close menu";

  function setOpen(open: boolean) {
    if (!button || !menu || !label) return;
    button.setAttribute("aria-expanded", open ? "true" : "false");
    menu.hidden = !open;
    label.textContent = open ? closeLabel : openLabel;
    if (open) {
      menu.querySelector<HTMLElement>("a")?.focus();
    }
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) => {
    link.addEventListener("click", () => {
      const hash = window.location.hash;
      if (!hash) return;
      const url = new URL(link.href);
      link.href = `${url.pathname}${hash}`;
    });
  });

  button?.addEventListener("click", () => {
    setOpen(button.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });

  function onScroll() {
    bar?.classList.toggle("is-stuck", window.scrollY > 8);
  }

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
  const sections = navLinks
    .map((link) => {
      return link.hash ? document.querySelector<HTMLElement>(link.hash) : null;
    })
    .filter((section): section is HTMLElement => section !== null);

  const uniqueSections = [...new Set(sections)];
  if (uniqueSections.length > 0) {
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const id = `#${visible.target.id}`;
        for (const link of navLinks) {
          if (link.hash === id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: [0.1, 0.3, 0.6] },
    );
    uniqueSections.forEach((section) => spy.observe(section));
  }
</script>
